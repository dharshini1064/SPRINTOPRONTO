# ==============================================================================
# SPRINTOPRONTO AI — ENVIRONMENT VARIABLES CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env.local' for local development:
#   cp .env.example .env.local
#
# For Render deployment: add each variable in your Render service's
# Environment tab (Dashboard → Your Service → Environment).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI REASONING SERVICE (Groq / LLaMA 3.3)
# ------------------------------------------------------------------------------
# Get your free key from: https://console.groq.com/
# Without this, the app runs in local-hybrid fallback mode (still works).
GROQ_API_KEY=gsk_your_groq_api_key_here

# ------------------------------------------------------------------------------
# 2. SECURE AUTHENTICATION (NextAuth.js)
# ------------------------------------------------------------------------------
# REQUIRED. Generate a cryptographically secure secret:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Or with openssl: openssl rand -base64 32
NEXTAUTH_SECRET=replace_with_generated_secret

# Your app's public URL.
# Local:  http://localhost:3000
# Render: https://your-app-name.onrender.com  (no trailing slash)
NEXTAUTH_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 3. DATABASE (PostgreSQL) — Optional, falls back to JSON file if not set
# ------------------------------------------------------------------------------
# Recommended for production. Options:
#   • Render Postgres: Dashboard → New → PostgreSQL → copy "Internal Connection String"
#   • Neon (free tier): https://neon.tech
#   • Supabase: https://supabase.com
#
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
# DATABASE_URL=postgresql://user:password@host:5432/sprintopronto?sslmode=require

# Optional: Override where the JSON fallback DB is stored (Render Persistent Disk mount path)
# DATA_DIR=/var/data

# ------------------------------------------------------------------------------
# 4. EXTERNAL INTEGRATIONS (Optional — all fall back to mock data)
# ------------------------------------------------------------------------------

# GitHub Personal Access Token — https://github.com/settings/tokens (repo read scope)
GITHUB_PAT=github_pat_your_token_here
GITHUB_REPO=owner/repo

# Linear API Key — https://linear.app/settings/api
LINEAR_API_KEY=lin_api_your_key_here

# Slack Bot Token — https://api.slack.com/apps (channels:history, channels:read)
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token-here
